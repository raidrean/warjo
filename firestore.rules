rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.email == 'akuadmin@gmail.com'; }

    match /menu/{id} {
      allow read: if true;
      allow write: if isAdmin();
      // pelanggan hanya boleh MENGURANGI stok saat memesan
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
                    && request.resource.data.stock >= 0
                    && request.resource.data.stock < resource.data.stock;
    }
    match /orders/{id} {
      allow get: if true;           // ID pesanan acak & sulit ditebak (untuk lacak status)
      allow list: if isAdmin();     // hanya admin yang bisa lihat semua pesanan
      allow create: if request.resource.data.status == 0
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50;
      allow update, delete: if isAdmin();
    }
  }
}
